    /* DOCUMENT GENERATOR */

    function generateDocument() {

        const type =
            document.getElementById("documentType").value;

        const name =
            document.getElementById("userName").value.trim();

        const recipient =
            document.getElementById("recipient").value.trim();

        const subject =
            document.getElementById("subject").value.trim();

        const description =
            document.getElementById("description").value.trim();


        if (!name || !recipient || !subject || !description) {

            alert(
                "Please complete all fields before generating the document."
            );

            return;

        }


        const titles = {

            complaint:
                "CONSUMER COMPLAINT LETTER",

            notice:
                "GENERAL LEGAL NOTICE",

            rti:
                "RIGHT TO INFORMATION APPLICATION",

            rental:
                "RENTAL AGREEMENT DRAFT",

            application:
                "LEGAL APPLICATION LETTER"

        };


        let content = "";


        if (type === "complaint") {

            content =
`From:
${name}

To:
${recipient}

Subject: ${subject}


Dear Sir/Madam,

I, ${name}, am writing regarding the following matter:

${description}


I request you to kindly review this matter and take appropriate action in accordance with the applicable rules and procedures.

I request that the matter be addressed at the earliest possible opportunity.

Thank you.

Yours faithfully,

${name}


Date: ${new Date().toLocaleDateString()}`;

        }


        else if (type === "notice") {

            content =
`LEGAL NOTICE – DRAFT

From:
${name}

To:
${recipient}

Subject: ${subject}


Dear Sir/Madam,

This document is a general draft prepared based on the information provided by the user.

Matter:

${description}


You are requested to review the facts, applicable law and supporting documents before using this draft.

Regards,

${name}

Date: ${new Date().toLocaleDateString()}`;

        }


        else if (type === "rti") {

            content =
`APPLICATION UNDER THE RIGHT TO INFORMATION FRAMEWORK

Applicant:
${name}

To:
${recipient}

Subject: ${subject}


Sir/Madam,

I respectfully request the following information:

${description}


Kindly provide the requested information according to the applicable RTI procedure and requirements.

Yours faithfully,

${name}

Date: ${new Date().toLocaleDateString()}`;

        }


        else if (type === "rental") {

            content =
`RENTAL AGREEMENT – BASIC DRAFT

PARTY 1:
${name}

PARTY 2:
${recipient}

SUBJECT:
${subject}


Property / Agreement Details:

${description}


The parties should review and modify the terms according to their actual agreement and applicable law.

Signature – Party 1:

____________________

Signature – Party 2:

____________________

Date:
${new Date().toLocaleDateString()}`;

        }


        else {

            content =
`LEGAL APPLICATION LETTER

Applicant:
${name}

To:
${recipient}

Subject: ${subject}


Dear Sir/Madam,

I am submitting this application regarding the following matter:

${description}


I kindly request that my application be considered according to the applicable rules and procedures.

Thank you.

Yours faithfully,

${name}

Date:
${new Date().toLocaleDateString()}`;

        }


        document.getElementById("previewTitle")
            .innerText = titles[type];

        document.getElementById("documentContent")
            .innerText = content;

    }


    /* DOWNLOAD DOCUMENT */

    function downloadDocument() {

        const title =
            document.getElementById("previewTitle").innerText;

        const content =
            document.getElementById("documentContent").innerText;


        if (
            !content ||
            content.includes("Your generated document")
        ) {

            alert("Please generate a document first.");

            return;

        }


        const fileContent =
`${title}

${content}

--------------------------------------------------

Legalease
AI-Powered Legal Document Generator

Disclaimer:
This generated document is a general draft for
informational purposes. Review the document and
obtain professional legal advice where appropriate.
`;


        const blob =
            new Blob(
                [fileContent],
                { type: "text/plain" }
            );


        const url =
            URL.createObjectURL(blob);


        const link =
            document.createElement("a");


        link.href = url;

        link.download =
            "Legalease_Document.txt";


        link.click();

        URL.revokeObjectURL(url);

    }


    /* AI ASSISTANT DEMO */

    function askAI() {

        const question =
            document.getElementById("aiQuestion")
            .value
            .trim();


        const answer =
            document.getElementById("aiAnswer");


        if (!question) {

            alert("Please enter a question.");

            return;

        }


        answer.style.display = "block";


        answer.innerHTML =
`
<strong>Legalease AI:</strong><br><br>

Your question has been received.

For this demonstration, Legalease identifies your
question and provides general legal-information
guidance.

<strong>Suggested approach:</strong>

• Identify the type of legal issue.<br>
• Collect relevant documents and evidence.<br>
• Check the applicable official government/legal resource.<br>
• Consider obtaining advice from a qualified legal professional
  for case-specific matters.

<br>

<strong>Question:</strong>
${escapeHTML(question)}

<br><br>

<small>
This is a demonstration response and should not be
treated as legal advice.
</small>
`;

    }


    /* SECURITY HELPER */

    function escapeHTML(text) {

        const div =
            document.createElement("div");

        div.textContent = text;

        return div.innerHTML;

    }


    /* ENTER KEY FOR AI */

    document
        .getElementById("aiQuestion")
        .addEventListener(
            "keydown",
            function(event) {

                if (event.key === "Enter") {

                    askAI();

                }

            }
        );

</script>

